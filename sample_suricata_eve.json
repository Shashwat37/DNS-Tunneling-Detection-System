# =============================================================================
# Suricata eve.json — Format Documentation
# =============================================================================
# Auto-detected when '"event_type"' AND '"dns"' both appear in the first
# 600 bytes of the file.
#
# Format: JSON Lines — one JSON object per line.
# Only lines where event_type == "dns" are processed; all others are skipped.
# Non-JSON lines (like this comment block) are also silently skipped.
#
# Standard field  ←  JSON path(s) extracted
# --------------  -----------------------------------------------------------
# timestamp       ← .timestamp
# domain          ← .dns.rrname  or  .dns.queries[0].rrname
#                   (trailing dot stripped)
# query_type      ← .dns.rrtype  or  .dns.queries[0].rrtype  (uppercased)
# response_size   ← sum of len(.dns.answers[n].rdata) for all answer records
#                   (0 when .dns.answers is absent, i.e. query-only events)
# query_length    ← computed from len(domain)
# subdomain_count ← computed from label count
#
# Supported event shapes:
#   Query event  : { "event_type": "dns", "dns": { "type": "query",
#                    "rrname": "example.com", "rrtype": "A" } }
#   Answer event : { "event_type": "dns", "dns": { "rrname": "example.com",
#                    "rrtype": "A", "answers": [{"rdata": "1.2.3.4"}] } }
#   Nested queries array also supported.
# =============================================================================
